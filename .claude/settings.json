{
  "enabledPlugins": {
    "woz@wozcode-marketplace": true
  },
  "agent": "woz:code",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "minici breakdown --path . --hook claude-pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/qa_closed_loop.sh"
          }
        ]
      }
    ]
  }
}
